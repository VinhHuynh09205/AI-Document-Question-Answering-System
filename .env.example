APP_NAME=AIChatBox
APP_ENV=development
API_V1_PREFIX=/api/v1
API_HOST_PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDINGS_MODEL=text-embedding-3-small
LOCAL_SEMANTIC_EMBEDDINGS_ENABLED=true
LOCAL_SEMANTIC_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# CPU speed profile option for multilingual office RAG: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_SEMANTIC_NORMALIZE_EMBEDDINGS=true
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_ENABLED=true
HYBRID_RETRIEVAL_ENABLED=true
RERANKING_ENABLED=true
VECTOR_STORE_PATH=data/faiss_index
VECTOR_BACKUP_DIR=data/faiss_backups
UPLOAD_DIR=data/uploads
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=aichatbox
PG_USER=aichatbox
PG_PASSWORD=aichatbox
USERS_FILE_PATH=data/users.json
SUPPORTED_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.md,.png,.jpg,.jpeg
REPLACE_EXISTING_DOCUMENTS_ON_UPLOAD=true
ENABLE_IMAGE_UNDERSTANDING=true
ENABLE_GEMINI_IMAGE_UNDERSTANDING=true
GEMINI_VISION_MODEL=gemini-2.0-flash
ENABLE_LOCAL_VISION_FALLBACK=true
LOCAL_VISION_ENDPOINT=http://localhost:11434
LOCAL_VISION_MODEL=llava:7b
LOCAL_VISION_MODEL_CANDIDATES=qwen2.5vl:7b,llava:13b,llava:7b
LOCAL_VISION_MAX_MODEL_ATTEMPTS=1
LOCAL_VISION_REQUEST_TIMEOUT_SECONDS=8
LOCAL_VISION_MAX_CONCURRENCY=1
ENABLE_LOCAL_OCR_FALLBACK=true
LOCAL_OCR_MAX_CONCURRENCY=1
IMAGE_UNDERSTANDING_MIN_BYTES=2048
IMAGE_UNDERSTANDING_MIN_EDGE_PIXELS=96
IMAGE_OCR_MIN_CONFIDENCE=0.35
OCR_MAX_VARIANTS_PER_IMAGE=2
OCR_MAX_SECONDS_PER_IMAGE=6
IMAGE_ANALYSIS_MAX_CONCURRENCY=2
IMAGE_ANALYSIS_TIMEOUT_SECONDS=25
IMAGE_ANALYSIS_MAX_LINES=12
IMAGE_ANALYSIS_MIN_MEANINGFUL_CHARS=10
IMAGE_ANALYSIS_MIN_AREA_PIXELS=14400
IMAGE_ANALYSIS_MIN_ENTROPY=2.2
IMAGE_ANALYSIS_MIN_TEXT_DENSITY=0.015
IMAGE_ANALYSIS_MAX_PIXELS=2200000
IMAGE_ANALYSIS_MIN_EDGE_MEAN=3.0
IMAGE_ANALYSIS_MIN_GRAYSCALE_STDDEV=6.0
PDF_MAX_IMAGES_PER_PAGE=2
PDF_MAX_PAGES_WITH_IMAGE_ANALYSIS=12
PDF_IMAGE_ANALYSIS_TEXT_CHAR_THRESHOLD=900
PDF_IMAGE_ANALYSIS_MAX_SECONDS_PER_DOCUMENT=20
DOCX_MAX_IMAGES_PER_DOCUMENT=4
DOCX_IMAGE_ANALYSIS_TEXT_CHAR_THRESHOLD=2200
DOCX_IMAGE_ANALYSIS_MAX_SECONDS_PER_DOCUMENT=20
PPTX_MAX_IMAGES_PER_SLIDE=2
PPTX_MAX_IMAGES_PER_DOCUMENT=24
PPTX_MAX_SLIDES_WITH_IMAGE_ANALYSIS=12
PPTX_IMAGE_ANALYSIS_TEXT_CHAR_THRESHOLD=950
PPTX_IMAGE_ANALYSIS_MAX_SECONDS_PER_DOCUMENT=25
AUTH_SECRET_KEY=change-me-in-production
ADMIN_SETUP_SECRET=
AUTH_TOKEN_EXPIRE_MINUTES=60
ENABLE_REGISTRATION=true
PASSWORD_RESET_EXPIRE_MINUTES=20
PASSWORD_RESET_FRONTEND_URL=http://localhost:8000/login
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_BASE=http://localhost:8000
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=6
MIN_CONTEXT_TOKEN_OVERLAP=0.2
MIN_RELEVANT_CHUNKS=1
MAX_ANSWER_CHARS=1200
INGESTION_MAX_FILE_WORKERS=4
EMBEDDING_BATCH_SIZE=64
UPLOAD_JOB_RETENTION_SECONDS=3600
UPLOAD_JOB_MAX_RETRIES=3
UPLOAD_JOB_WORKER_POLL_SECONDS=0.8
UPLOAD_JOB_STALE_PROCESSING_SECONDS=120
LOG_LEVEL=INFO
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_WINDOW=20
REGISTER_RATE_LIMIT_PER_WINDOW=10
ASK_RATE_LIMIT_PER_WINDOW=60
UPLOAD_RATE_LIMIT_PER_WINDOW=30
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=*
ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=false

# Suggested profile defaults
# DEVELOPMENT
# APP_ENV=development
# LOG_LEVEL=INFO
# RATE_LIMIT_WINDOW_SECONDS=60
# ASK_RATE_LIMIT_PER_WINDOW=120
# UPLOAD_RATE_LIMIT_PER_WINDOW=60
# ENABLE_HSTS=false

# STAGING
# APP_ENV=staging
# LOG_LEVEL=INFO
# RATE_LIMIT_WINDOW_SECONDS=60
# ASK_RATE_LIMIT_PER_WINDOW=60
# UPLOAD_RATE_LIMIT_PER_WINDOW=30

# PRODUCTION
# APP_ENV=production
# LOG_LEVEL=WARNING
# RATE_LIMIT_WINDOW_SECONDS=60
# ASK_RATE_LIMIT_PER_WINDOW=30
# UPLOAD_RATE_LIMIT_PER_WINDOW=15
# ENABLE_HSTS=true
